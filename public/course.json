      }
    },
    {
      "id": "builder",
      "group": "counter",
      "title": {
        "es-MX": "Pedido a la medida",
        "en": "Custom order"
      }
    },
    {
      "id": "singleton",
      "group": "counter",
      "title": {
        "es-MX": "Turnos repetidos",
        "en": "Repeated ticket numbers"
      }
    },
    {
      "id": "adapter",
      "group": "bar",
      "title": {
        "es-MX": "La terminal nueva",
        "en": "The new terminal"
      }
    },
    {
      "id": "decorator",
      "group": "bar",
      "title": {
        "es-MX": "Extras sin fin",
        "en": "Endless extras"
      }
    },
    {
      "id": "composite",
      "group": "bar",
      "title": {
        "es-MX": "Combos dentro de combos",
        "en": "Combos inside combos"
      }
    },
    {
      "id": "facade",
      "group": "bar",
      "title": {
