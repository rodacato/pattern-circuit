    {
      "id": "template-method",
      "group": "rush-hour",
      "title": {
        "es-MX": "Recetas copiadas",
        "en": "Copied recipes"
      }
    },
    {
      "id": "branches-and-payments",
      "group": "all-together",
      "title": {
        "es-MX": "Sucursales y pagos",
        "en": "Branches and payments"
      }
    },
    {
      "id": "combos-with-extras",
      "group": "all-together",
      "title": {
        "es-MX": "Combos con extras",
        "en": "Combos with extras"
      }
    },
    {
      "id": "live-orders",
      "group": "all-together",
      "title": {
        "es-MX": "Pedidos en vivo",
        "en": "Live orders"
      }
    },
    {
      "id": "ports-and-adapters",
      "group": "architecture",
      "title": {
        "es-MX": "El núcleo y el mundo",
        "en": "The core and the world"
      }
    },
    {
      "id": "event-bus",
      "group": "architecture",
      "title": {
        "es-MX": "Servicios que se enteran",
        "en": "Services that find out"
      }
    },
    {
      "id": "cqrs",
      "group": "architecture",
      "title": {
        "es-MX": "Mil pantallas, un mostrador",
        "en": "A thousand displays, one counter"
      }
    },
    {
      "id": "null-object",
      "group": "resilience",
      "title": {
        "es-MX": "El cliente sin tarjeta",
        "en": "The customer without a card"
      }
    },
    {
      "id": "circuit-breaker",
      "group": "resilience",
      "title": {
        "es-MX": "El proveedor se cayó",
        "en": "The provider went down"
      }
    },
    {
      "id": "saga",
      "group": "resilience",
      "title": {
        "es-MX": "Cobrado y sin avena",
        "en": "Charged and out of oat milk"
      }
    },
    {
      "id": "single-payment",
      "group": "judgment",
      "title": {
        "es-MX": "Un solo método de pago",
        "en": "A single payment method"
      }
    },
    {
      "id": "single-listener",
      "group": "judgment",
      "title": {
        "es-MX": "Un solo interesado",
        "en": "A single interested party"
      }
    },
    {
      "id": "full-cafe",
      "group": "final",
      "title": {
        "es-MX": "La cafetería completa",
        "en": "The complete coffee shop"
      }
    }
