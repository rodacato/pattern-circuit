  "completion": {
    "requires": "all"
  },
  "capabilities": {
    "codeRunner": "none",
    "theming": {
      "modes": [
        "light",
        "dark"
      ],
      "honors": [
        "page",
        "surface",
        "elevated",
        "border",
        "textPrimary",
        "textSecondary",
        "textMuted",
        "accent",
        "fontSans",
        "fontMono"
      ]
    },
    "minViewport": {
      "width": 640,
      "height": 480
    },
    "persistsOwnState": true
  }
}
