{
  "schema": 1,
  "id": "pattern-circuit",
  "version": "1.1.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "title": {
    "es-MX": "Patrones de diseño",
    "en": "Design patterns"
  },
  "description": {
    "es-MX": "Aprende patrones de diseño enchufándolos en el circuito de una cafetería.",
    "en": "Learn design patterns by plugging them into a cafeteria circuit."
  },
  "locales": [
    "es-MX",
    "en"
  ],
  "defaultLocale": "en",
  "codeLanguages": [
    "ruby",
    "typescript"
  ],
  "defaultCodeLanguage": "ruby",
  "entry": "./index.html",
  "groups": [
    {
      "id": "opening",
      "title": {
        "es-MX": "Apertura",
        "en": "Opening"
      }
    },
    {
      "id": "counter",
      "title": {
        "es-MX": "El mostrador",
        "en": "The counter"
      }
    },
    {
      "id": "bar",
      "title": {
        "es-MX": "La barra crece",
        "en": "The bar grows"
      }
    },
    {
      "id": "rush-hour",
      "title": {
        "es-MX": "Hora pico",
        "en": "Rush hour"
      }
    },
    {
      "id": "all-together",
      "title": {
        "es-MX": "Todo junto",
        "en": "All together"
      }
    },
    {
      "id": "architecture",
      "title": {
        "es-MX": "Arquitectura",
        "en": "Architecture"
      }
    },
    {
      "id": "resilience",
      "title": {
        "es-MX": "Resiliencia",
        "en": "Resilience"
      }
    },
    {
      "id": "judgment",
      "title": {
        "es-MX": "Criterio: cuándo no",
        "en": "Judgment: when not to"
      }
    },
    {
      "id": "final",
      "title": {
        "es-MX": "La cafetería completa",
        "en": "The whole coffee shop"
      }
    }
