{
  "name": "pattern-circuit",
  "private": true,
  "version": "1.1.0",
  "description": "A design patterns game: plug patterns into a coffee shop's circuit and watch every order flow through them.",
  "license": "MIT",
  "homepage": "https://rodacato.github.io/pattern-circuit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodacato/pattern-circuit.git"
  },
  "bugs": "https://github.com/rodacato/pattern-circuit/issues",
  "author": "Adrian Castillo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "demo": "npm run build && node scripts/record-demo.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check": "tsc -b && oxlint && vitest run",
    "coverage": "vitest run --coverage",
    "i18n:scaffold": "node scripts/i18n-scaffold.mjs",
    "host:test": "vite --config host-test/vite.config.ts"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  }
}
